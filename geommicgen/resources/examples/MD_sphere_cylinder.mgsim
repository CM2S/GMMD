# 3D Example
# Microstructure containing two phases
#	- sphere phase with 5% volume fraction.
#	- cylinder phase with 5% volume fraction
# The microstructure generation method used is Molecular Dynamics (MD)


Problem_Type 1
N_DP_Samples 1
RVE_Dimensions [1, 1, 1]

# Microstructure definition
# ------------------------------------------------------------------------------------------
Mic_Gen_Descriptors
Phase 0
Phase_Type 1

Phase 1
Phase_Type 4
vf 0.05
r 0.04

Phase 2
Phase_Type 7
r_cyl 0.05
length 0.1
azimuth_angle 0
polar_angle 0.2618
vf 0.05


# Generation parameters
# ------------------------------------------------------------------------------------------
Mic_Gen_Method MD
Min_Distance 0.002
Max_Residue_Per_Particle 0
Max_Step 200
Speed_Up_Scheme Verlet
Verlet_Factor 1.1
Save_History True
final_config True

