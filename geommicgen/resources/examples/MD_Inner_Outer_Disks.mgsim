# 2D Example
# Microstructure containing three phases:
#	- matrix phase
#	- outer phase: disks with 40% volume fraction
#	- inner phase: small disks with 4% volume fraction, placed inside the outer disks
# The microstructure generation method used is Molecular Dynamics

Problem_Type 1
N_DP_Samples 1
RVE_Dimensions [1, 1]

# Microstructure definition
# ------------------------------------------------------------------------------------------
Mic_Gen_Descriptors
Phase 0
Phase_Type 1
Phase 1
Phase_Type 2
r 0.08
vf 0.4
Phase 2
Phase_Type 2
inner_phase True
outer_phase 1
r 0.015
vf 0.04

# Generation parameters
# ------------------------------------------------------------------------------------------
Mic_Gen_Method RSA
#Max_Residue_Per_Particle 0
Max_Step 100
#Speed_Up_Scheme Verlet
#Verlet_Factor 1.1
Min_Distance 0.005
#Inner_Phase_Max_Step 10

# Post-processing
# -----------------------------------------------------------------------------------------
Save_History True
final_config True
#sim_gif True


# Mesh generation
# ------------------------------------------------------------------------------------------
#Mesh_Options

#rgmsh
#n_voxels_dims [1000, 1000]
