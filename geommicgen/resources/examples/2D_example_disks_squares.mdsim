# 2D Example
# Microstructure containing two phases
#	- square phase with 20% volume fraction. Its side varies according to a Normal distribution
#	- disk phase with 20% volume fraction
# The microstructure generation method used is Random Sequential Adsorption (RSA)

Problem_Type 1
N_DP_Samples 1
RVE_Dimensions [1, 1]

# Microstructure definition
# ------------------------------------------------------------------------------------------
Mic_Gen_Descriptors
Phase 0
Phase_Type 1
Phase 1
Phase_Type 2
r 0.05
vf 0.15
Phase 2
Phase_Type 8
vf 0.15
side_distribution normal
side_mean 0.1
side_sigma 0.01
Min_Distance 0.01



# Generation parameters
# ------------------------------------------------------------------------------------------
Mic_Gen_Method RSA
Max_Step 10000
Save_History True # For now this is not being used
final_config True # For now this is not being used

# Mesh generation
# ------------------------------------------------------------------------------------------
Mesh_Options

rgmsh
n_voxels_dims [1000, 1000]
