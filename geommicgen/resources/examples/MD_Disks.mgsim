# 2D Example
# Microstructure containing one phase, a disk phase with 50% volume fraction
# The microstructure generation method used is Molecular Dynamics

Problem_Type 1
N_DP_Samples 1
RVE_Dimensions [1, 1]

# Microstructure definition
# ------------------------------------------------------------------------------------------
Mic_Gen_Descriptors
Phase 0
Phase_Type 1
Phase 1
Phase_Type 2
r_distribution discrete
    r_value_1 0.05
    r_prob_1 0.4
    r_value_2 0.02
    r_prob_2 0.5
    r_value_3 0.1
    r_prob_3 0.1
vf 0.5

# Generation parameters
# ------------------------------------------------------------------------------------------
Mic_Gen_Method MD
Max_Residue_Per_Particle 0
Max_Step 100
Speed_Up_Scheme Verlet
Verlet_Factor 1.1
Min_Distance 0.005

# Post-processing
# -----------------------------------------------------------------------------------------
Save_History True
final_config True
sim_gif True

# Mesh generation
# ------------------------------------------------------------------------------------------
#Mesh_Options

#rgmsh
#n_voxels_dims [1000, 1000]
