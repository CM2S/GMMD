# 2D Example
# Microstructure containing a single phase with squares.


Problem_Type 1
N_DP_Samples 1
RVE_Dimensions [1.9, 1]

# Microstructure definition
# ------------------------------------------------------------------------------------------
Mic_Gen_Descriptors
Phase 0
Phase_Type 1
Phase 1
Phase_Type 8
vf 0.2
side_distribution normal
side_mean 0.1
side_sigma 0.02
Min_Distance 0.05




# Generation parameters
# ------------------------------------------------------------------------------------------
Mic_Gen_Method MD
Max_Residue_Per_Particle 0
Max_Step 50
Speed_Up_Scheme Verlet
Verlet_Factor 1.1
Save_History True
final_config True


# Mesh generation
# ------------------------------------------------------------------------------------------
Mesh_Options

rgmsh
n_voxels_dims [1000, 1000]
