# DEEP CUTS
# ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

#                                                    Number of iterations for relaxation [O]
# ==========================================================================================
# Meaning:   The number of iterations allowed for the system to still move after reaching a
#            legal configuration.
#
# Syntax:    Max_Steps_To_Relax x
#
# x:         integer (default to 0)
# ------------------------------------------------------------------------------------------
[insert here]

#                                                                  Integration time step [O]
# ==========================================================================================
# Meaning:   Integration time step for the numerical integration of the equations of motion
#            in the molecular dynamics simulation.
#
# Syntax:    dt x (default to 0.05)
#
# x:         float
# ------------------------------------------------------------------------------------------
[insert here]

#                                                         Seed for initial configuration [O]
# ==========================================================================================
# Meaning:   Use the given value to seed the initial configuration.
#
# Syntax:    fixed_seed x
#
# x:         int
# ------------------------------------------------------------------------------------------
[insert here]

#                                                                          Force rescale [O]
# ==========================================================================================
# Meaning:   Flag for the use of a force rescaling procedure, that approximates the sceme
#            described in Salnikov et al. (2015).
#
# Syntax:    Force_Rescale x
#
# x:         float
# ------------------------------------------------------------------------------------------
[insert here]

#                                                           Option for the particle mass [O]
# ==========================================================================================
# Meaning:   Option for the mass of the particles.
#
# Syntax:    Particle_Mass_Opt x
#
# x:         {"volume", "radius", "unit"}
#
#            "volume" - mass equal to the volume/area of the particle.
#            "radius" - mass equal to the radius of the circumscribed sphere/disk.
#            "unit"   - unit mass for all particles.
# ------------------------------------------------------------------------------------------
[insert here]

#                                                             Type of interaction forces [O]
# ==========================================================================================
# Meaning:   Type of the interaction forces prescribed for intersection particles.
#
# Syntax:    Force_Option x
#
# x:         {"intersection_length", "intersection_area"}
#
#            "intersection_length" - intersection force proportional to the intersection
#                length between the interacting particles.
#            "intersection_area"   - intersection force proportional to the intersection
#                area/volume between the interacting particles.
# ------------------------------------------------------------------------------------------
[insert here]

#                                                                        Viscous damping [O]
# ==========================================================================================
# Meaning:   Viscous damping coefficient.
#
# Syntax:    Damping_Coeff x
#
# x:         float
# ------------------------------------------------------------------------------------------
[insert here]

#                                                                           Problem type [O]
# ==========================================================================================
# Meaning:   Not used. The dimension of the problem is that of RVE_Dimensions, and the
#            analysis type of a solver deck is written by its writer. The keyword is
#            still read so that older input data files, which had to give it, still do.
#
# Syntax:    Problem_Type x
# ------------------------------------------------------------------------------------------
